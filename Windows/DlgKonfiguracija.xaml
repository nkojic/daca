<Window x:Class="WpfAmsterdam.DlgKonfiguracija"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Konfiguracija" Height="250" Width="420"
    WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
    Background="#F5F6F8">

    <Border CornerRadius="12" Background="White" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="24">
            <TextBlock Text="Podešavanja" FontSize="18" FontWeight="Bold"
                       Foreground="#2D3436" Margin="0,0,0,20"/>

            <CheckBox x:Name="chkKoristiKartice" FontSize="14" Foreground="#636E72"
                      Margin="0,0,0,8" VerticalContentAlignment="Center">
                <TextBlock Text="Koristiti kartice konobara" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock Text="Ako je isključeno, nakon prvog logovanja ne zahteva se ponovna prijava."
                       FontSize="11" Foreground="#B2BEC3" Margin="20,0,0,20" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Sačuvaj" Width="90" Height="36" FontSize="13" FontWeight="SemiBold"
                        Foreground="White" Cursor="Hand" Click="btnSacuvaj_Click" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#55EFC4" Offset="0"/>
                            <GradientStop Color="#00B894" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
                <Button Content="Zatvori" Width="90" Height="36" FontSize="13" FontWeight="SemiBold"
                        Foreground="#636E72" Cursor="Hand" Click="btnZatvori_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F0F2F5" Offset="0"/>
                            <GradientStop Color="#DFE6E9" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
