<Window x:Class="WpfAmsterdam.DlgEnergyStar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="EnergyStar"
    WindowStartupLocation="CenterScreen"
    Background="#F5F6F8"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Stil za selektovani red u obe tabele -->
        <Style x:Key="SelectionRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF6B35"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFC"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#FF6B35"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- Stil za selektovanu ćeliju -->
        <Style x:Key="SelectionCellStyle" TargetType="DataGridCell">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF6B35"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#FF6B35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stil za tastere Upari/Raspari -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="10" Padding="8,4"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="#E8ECF1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2C2B4A" Offset="0"/>
                    <GradientStop Color="#3E3D5E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <TextBlock Text="EnergyStar" FontSize="18" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            </DockPanel>
        </Border>

        <!-- Tasteri Upari / Raspari -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,10,12,4">
            <Button x:Name="btnUpari" Content="Upari" IsEnabled="False"
                    Style="{StaticResource ActionButtonStyle}"
                    Foreground="White" Click="btnUpari_Click">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00B894" Offset="0"/>
                        <GradientStop Color="#00A383" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <Button x:Name="btnRaspari" Content="Raspari" IsEnabled="False"
                    Style="{StaticResource ActionButtonStyle}"
                    Foreground="White" Click="btnRaspari_Click">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E17055" Offset="0"/>
                        <GradientStop Color="#D63031" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </StackPanel>

        <!-- Sadržaj: dve tabele -->
        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- Leva tabela: Naši artikli -->
            <DockPanel Grid.Column="0">
                <TextBlock Text="Naši artikli" FontSize="14" FontWeight="SemiBold"
                           Foreground="#2D3436" Margin="0,0,0,8" DockPanel.Dock="Top"/>
                <TextBox x:Name="txtPretragaLevo" Height="30" FontSize="13"
                         Padding="8,4" Margin="0,0,0,8" DockPanel.Dock="Top"
                         BorderBrush="#E8ECF1" BorderThickness="1"
                         TextChanged="txtPretragaLevo_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Resources>
                                <VisualBrush x:Key="Placeholder" TileMode="None" Stretch="None" AlignmentX="Left">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="Pretraži artikle..." FontSize="13"
                                                   Foreground="#B2BEC3" Margin="8,4,0,0"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource Placeholder}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <DataGrid x:Name="dgArtikli"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="1"
                          BorderBrush="#E8ECF1"
                          Background="White"
                          HeadersVisibility="Column"
                          FontSize="13"
                          ColumnHeaderHeight="36"
                          RowHeight="30"
                          AlternationCount="2"
                          RowStyle="{StaticResource SelectionRowStyle}"
                          CellStyle="{StaticResource SelectionCellStyle}"
                          SelectionChanged="dgArtikli_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID artikla" Binding="{Binding IdArtikla}" Width="80"/>
                        <DataGridTextColumn Header="Ime artikla" Binding="{Binding ImeArtikla}" Width="*"/>
                        <DataGridTextColumn Header="ID artikla EnergyStar" Binding="{Binding IdArtiklaES}" Width="140"/>
                        <DataGridTextColumn Header="Ime artikla EnergyStar" Binding="{Binding ImeArtiklaES}" Width="*"/>
                        <DataGridTextColumn Header="Upareno" Binding="{Binding Upareno}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Desna tabela: EnergyStar katalog -->
            <DockPanel Grid.Column="2">
                <TextBlock Text="EnergyStar katalog" FontSize="14" FontWeight="SemiBold"
                           Foreground="#2D3436" Margin="0,0,0,8" DockPanel.Dock="Top"/>
                <TextBox x:Name="txtPretragaDesno" Height="30" FontSize="13"
                         Padding="8,4" Margin="0,0,0,8" DockPanel.Dock="Top"
                         BorderBrush="#E8ECF1" BorderThickness="1"
                         TextChanged="txtPretragaDesno_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Resources>
                                <VisualBrush x:Key="Placeholder" TileMode="None" Stretch="None" AlignmentX="Left">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="Pretraži EnergyStar..." FontSize="13"
                                                   Foreground="#B2BEC3" Margin="8,4,0,0"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource Placeholder}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <DataGrid x:Name="dgEnergyStar"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="1"
                          BorderBrush="#E8ECF1"
                          Background="White"
                          HeadersVisibility="Column"
                          FontSize="13"
                          ColumnHeaderHeight="36"
                          RowHeight="30"
                          AlternationCount="2"
                          RowStyle="{StaticResource SelectionRowStyle}"
                          CellStyle="{StaticResource SelectionCellStyle}"
                          SelectionChanged="dgEnergyStar_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID artikla EnergyStar" Binding="{Binding IdArtiklaES}" Width="140"/>
                        <DataGridTextColumn Header="Ime artikla EnergyStar" Binding="{Binding ImeArtiklaES}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Padding="12,10" Background="#FAFBFC"
                BorderThickness="0,1,0,0" BorderBrush="#E8ECF1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Zatvori" Width="90" Height="34" FontSize="13" FontWeight="SemiBold"
                        Foreground="#636E72" Cursor="Hand" Click="btnZatvori_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8,4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F0F2F5" Offset="0"/>
                            <GradientStop Color="#DFE6E9" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
