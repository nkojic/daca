<Window x:Class="WpfAmsterdam.Window2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Window2" Height="710" Width="1310" MinHeight="700" MinWidth="1300" WindowState="Maximized">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                           x:Name="Border"
                           CornerRadius="2"
                           BorderThickness="1"
                           BorderBrush="Black">
                            <ContentPresenter
                              Margin="2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style BasedOn="{StaticResource {x:Type Button}}"
           TargetType="Button"
           x:Key="Okrugli">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                           x:Name="Border"
                           CornerRadius="27"
                           BorderThickness="1"
                           BorderBrush="Black">
                            <ContentPresenter
                              Margin="2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Resources/wine03.jpg" Opacity="0.3" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Kontrolna dugmad - gornji red -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <Button Name="izlaz" Height="55" Width="55" Content="Kraj" Background="Red" Foreground="White" Margin="5"/>
            <Button Name="ZamenaStolova" Height="55" Width="75" Content="Stolovi" Background="Yellow" FontSize="13" Margin="5"/>
            <Button Name="ZamenaKonobara" Height="55" Width="75" Content="Konobari" Background="Yellow" FontSize="13" Margin="5"/>
            <Button Name="RasporedStolova" Height="55" Width="85" Content="Raspored" Background="Yellow" FontSize="13" Margin="5"/>
            <Button Style="{StaticResource Okrugli}" Name="exp" Height="60" Width="60" Content="exp" Background="White" Margin="5"/>
            <Button Name="staf" Height="55" Width="55" Content="staf" Background="White" Margin="5"/>
        </StackPanel>

        <!-- Dinamički stolovi iz baze -->
        <Canvas x:Name="canvasTables" Grid.Row="1" ClipToBounds="True"/>
    </Grid>
</Window>
