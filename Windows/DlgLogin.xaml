<Window x:Class="WpfAmsterdam.DlgLogin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Prijava" Height="280" Width="400"
    WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    UseLayoutRounding="True" SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <Border CornerRadius="16" Margin="10" x:Name="mainBorder">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FDFEFE" Offset="0"/>
                <GradientStop Color="#F0F2F5" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.2" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="20,16" x:Name="headerBorder">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2C2B4A" Offset="0"/>
                        <GradientStop Color="#3E3D5E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="Prijava" FontSize="18" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
            </Border>

            <!-- Sadržaj -->
            <StackPanel Grid.Row="1" Margin="30,24,30,24" VerticalAlignment="Center">
                <TextBlock x:Name="txtPoruka" Text="Provucite karticu ili unesite šifru"
                           FontSize="14" Foreground="#636E72" HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <TextBox x:Name="txtSifra" FontSize="20" Height="44"
                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         BorderBrush="#D4E6F1" BorderThickness="2"
                         Padding="8,4" Margin="0,0,0,16"
                         KeyDown="txtSifra_KeyDown"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Button Content="Prijavi se" Width="120" Height="40" FontSize="14"
                            FontWeight="SemiBold" Foreground="White" Cursor="Hand"
                            Click="btnPrijava_Click" x:Name="btnPrijava" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#27AE60" Offset="0"/>
                                <GradientStop Color="#1E8449" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button Content="Izlaz" Width="90" Height="40" FontSize="14"
                            FontWeight="SemiBold" Foreground="#636E72" Cursor="Hand"
                            Click="btnIzlaz_Click" x:Name="btnIzlaz">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F0F2F5" Offset="0"/>
                                <GradientStop Color="#DFE6E9" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
