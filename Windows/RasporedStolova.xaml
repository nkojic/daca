<Window x:Class="WpfAmsterdam.RasporedStolova"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Raspored stolova" Height="750" Width="1200" MinHeight="600" MinWidth="900"
    WindowStartupLocation="CenterScreen" Loaded="Window_Loaded"
    Background="#F5F6F8"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style TargetType="Button" x:Key="StoKvadrat">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Foreground" Value="#636E72"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                           CornerRadius="10"
                           BorderThickness="2"
                           BorderBrush="#DFE6E9">
                            <ContentPresenter
                              Margin="2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="StoKrug">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Foreground" Value="#636E72"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                           CornerRadius="30"
                           BorderThickness="2"
                           BorderBrush="#DFE6E9">
                            <ContentPresenter
                              Margin="2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="BtnToolbar">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="White" Margin="10" ClipToBounds="True">
        <DockPanel>
            <!-- Gornji deo - toolbar -->
            <Border DockPanel.Dock="Top" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="#E8ECF1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FAFBFC" Offset="0"/>
                        <GradientStop Color="#F0F2F5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Inicijalno kreiranje -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBox x:Name="txtSquareCount" Width="50" Height="30" FontSize="15"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 BorderBrush="#DFE6E9" BorderThickness="1"/>
                        <Border Width="20" Height="20" BorderBrush="#DFE6E9" BorderThickness="2"
                                CornerRadius="4" Background="#F0F2F5" Margin="5,0,4,0"/>
                        <TextBlock Text="Kvadratni" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#636E72" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBox x:Name="txtRoundCount" Width="50" Height="30" FontSize="15"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 BorderBrush="#DFE6E9" BorderThickness="1"/>
                        <Border Width="22" Height="22" BorderBrush="#DFE6E9" BorderThickness="2"
                                CornerRadius="11" Background="#F0F2F5" Margin="5,0,4,0"/>
                        <TextBlock Text="Kružni" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#636E72" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </StackPanel>
                    <Button x:Name="btnPrikazi" Style="{StaticResource BtnToolbar}"
                            Content="Prikaži" Margin="0,0,6,0" Click="btnPrikazi_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#55EFC4" Offset="0"/>
                                <GradientStop Color="#00B894" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <!-- Separator -->
                    <Border Width="2" Height="30" Background="#DFE6E9" Margin="10,0"/>

                    <!-- Dodavanje -->
                    <Button x:Name="btnDodajKvadrat" Style="{StaticResource BtnToolbar}"
                            Content="+ Kvadratni" Margin="0,0,6,0" Click="btnDodajKvadrat_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#74B9FF" Offset="0"/>
                                <GradientStop Color="#0984E3" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button x:Name="btnDodajKrug" Style="{StaticResource BtnToolbar}"
                            Content="+ Kružni" Margin="0,0,6,0" Click="btnDodajKrug_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#A29BFE" Offset="0"/>
                                <GradientStop Color="#6C5CE7" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button x:Name="btnObrisi" Style="{StaticResource BtnToolbar}"
                            Content="Obriši" Margin="0,0,6,0" Click="btnObrisi_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF7675" Offset="0"/>
                                <GradientStop Color="#E17055" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <!-- Separator -->
                    <Border Width="2" Height="30" Background="#DFE6E9" Margin="10,0"/>

                    <!-- Pasivni elementi -->
                    <Button x:Name="btnDodajZonu" Style="{StaticResource BtnToolbar}"
                            Content="+ Zona" Margin="0,0,6,0" Click="btnDodajZonu_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#81ECEC" Offset="0"/>
                                <GradientStop Color="#00CEC9" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button x:Name="btnDodajLabelu" Style="{StaticResource BtnToolbar}"
                            Content="+ Labela" Margin="0,0,6,0" Click="btnDodajLabelu_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#DFE6E9" Offset="0"/>
                                <GradientStop Color="#B2BEC3" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button x:Name="btnDodajZid" Style="{StaticResource BtnToolbar}"
                            Content="+ Zid" Margin="0,0,6,0" Click="btnDodajZid_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#636E72" Offset="0"/>
                                <GradientStop Color="#2D3436" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <!-- Separator -->
                    <Border Width="2" Height="30" Background="#DFE6E9" Margin="10,0"/>

                    <!-- Snimi / Zatvori -->
                    <Button x:Name="btnSnimi" Style="{StaticResource BtnToolbar}"
                            Content="Snimi" Margin="0,0,6,0" Click="btnSnimi_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FDCB6E" Offset="0"/>
                                <GradientStop Color="#F0932B" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button x:Name="btnZatvori" Style="{StaticResource BtnToolbar}"
                            Content="Zatvori" Click="btnZatvori_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F0F2F5" Offset="0"/>
                                <GradientStop Color="#DFE6E9" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Foreground>
                            <SolidColorBrush Color="#636E72"/>
                        </Button.Foreground>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Status bar -->
            <Border DockPanel.Dock="Top" Padding="16,8" Background="#FAFBFC"
                    BorderThickness="0,0,0,1" BorderBrush="#EEF1F5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,20,0" VerticalAlignment="Center" FontSize="12" Foreground="#636E72">
                        <Run Text="Ukupno: "/><Run x:Name="txtTotal" FontWeight="Bold" Text="0"/>
                    </TextBlock>
                    <TextBlock Margin="0,0,20,0" VerticalAlignment="Center" FontSize="12" Foreground="#636E72">
                        <Run Text="Kvadratni: "/><Run x:Name="txtSqCount" FontWeight="Bold" Text="0"/>
                    </TextBlock>
                    <TextBlock Margin="0,0,20,0" VerticalAlignment="Center" FontSize="12" Foreground="#636E72">
                        <Run Text="Kružni: "/><Run x:Name="txtRdCount" FontWeight="Bold" Text="0"/>
                    </TextBlock>
                    <TextBlock x:Name="txtMode" Margin="20,0,0,0" VerticalAlignment="Center"
                               FontSize="11" FontWeight="Bold" Foreground="#555" Text=""/>
                    <TextBlock Margin="30,0,0,0" VerticalAlignment="Center" FontSize="11"
                               Foreground="#B2BEC3" FontStyle="Italic"
                               Text="Dvoklik za promenu imena  |  Zone: ivice za resize  |  Zid: dvoklik rotira"/>
                </StackPanel>
            </Border>

            <!-- Canvas za stolove sa grid pattern -->
            <Border x:Name="canvasBorder" Margin="12" CornerRadius="14"
                    BorderThickness="1" BorderBrush="#EEF1F5" ClipToBounds="True">
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,30,30" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#FAFBFC">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,30,30"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#E8ECF1" Thickness="0.5"/>
                                    </GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="30,0" EndPoint="30,30"/>
                                            <LineGeometry StartPoint="0,30" EndPoint="30,30"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
                <Canvas x:Name="canvasStolovi" ClipToBounds="True"/>
            </Border>
        </DockPanel>
    </Border>
</Window>
