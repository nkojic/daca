<Window x:Class="WpfAmsterdam.RasporedStolova"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Raspored stolova" Height="750" Width="1200" MinHeight="600" MinWidth="900"
    WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="Button" x:Key="StoKvadrat">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                           CornerRadius="2"
                           BorderThickness="1"
                           BorderBrush="Black">
                            <ContentPresenter
                              Margin="2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="StoKrug">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                           CornerRadius="30"
                           BorderThickness="1"
                           BorderBrush="Black">
                            <ContentPresenter
                              Margin="2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Gornji deo - konfiguracija -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#E8E8E8"
                    Height="60" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                <TextBox x:Name="txtSquareCount" Width="55" Height="30" FontSize="16"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                         Margin="0,0,5,0"/>
                <Border Width="22" Height="22" BorderBrush="Black" BorderThickness="1"
                        CornerRadius="2" Background="White" Margin="0,0,5,0"/>
                <TextBlock Text="Kvadratni stolovi" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,25,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="txtRoundCount" Width="55" Height="30" FontSize="16"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                         Margin="0,0,5,0"/>
                <Border Width="24" Height="24" BorderBrush="Black" BorderThickness="1"
                        CornerRadius="12" Background="White" Margin="0,0,5,0"/>
                <TextBlock Text="Kružni stolovi" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,25,0"/>
            </StackPanel>
            <Button x:Name="btnPrikazi" Content="Prikaži" Width="80" Height="35"
                    FontSize="14" FontWeight="Bold" Background="#4CAF50" Foreground="White"
                    Margin="0,0,10,0" Click="btnPrikazi_Click"/>
            <Button x:Name="btnSnimi" Content="Snimi" Width="80" Height="35"
                    FontSize="14" FontWeight="Bold" Background="#FFD700"
                    Margin="0,0,10,0" Click="btnSnimi_Click"/>
            <Button x:Name="btnZatvori" Content="Zatvori" Width="80" Height="35"
                    FontSize="14" FontWeight="Bold" Background="#DC3545" Foreground="White"
                    Click="btnZatvori_Click"/>
        </StackPanel>

        <!-- Donji deo - canvas za stolove -->
        <Border Margin="10" BorderBrush="Black" BorderThickness="2" Background="White">
            <Canvas x:Name="canvasStolovi" ClipToBounds="True"/>
        </Border>
    </DockPanel>
</Window>
