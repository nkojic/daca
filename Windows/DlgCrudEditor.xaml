<Window x:Class="WpfAmsterdam.DlgCrudEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Editor" Height="600" Width="900"
    WindowStartupLocation="CenterScreen"
    Background="#F5F6F8"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="#E8ECF1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2C2B4A" Offset="0"/>
                    <GradientStop Color="#3E3D5E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <TextBlock x:Name="txtTitle" Text="Editor" FontSize="18" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBlock x:Name="txtCount" FontSize="13" Foreground="#B2BEC3"
                           VerticalAlignment="Center" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" x:Name="dataGrid" Margin="12"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="#E8ECF1"
                  Background="White"
                  RowBackground="White"
                  AlternatingRowBackground="#FAFBFC"
                  HeadersVisibility="Column"
                  FontSize="13"
                  ColumnHeaderHeight="36"
                  RowHeight="32"/>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="12,10" Background="#FAFBFC"
                BorderThickness="0,1,0,0" BorderBrush="#E8ECF1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="+ Dodaj novi" Width="120" Height="34" FontSize="13" FontWeight="SemiBold"
                            Foreground="White" Cursor="Hand" Click="btnDodaj_Click" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8,4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#27AE60" Offset="0"/>
                                <GradientStop Color="#1E8449" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button Content="Obriši izabrani" Width="120" Height="34" FontSize="13" FontWeight="SemiBold"
                            Foreground="White" Cursor="Hand" Click="btnObrisi_Click" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8,4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E74C3C" Offset="0"/>
                                <GradientStop Color="#C0392B" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Sačuvaj izmene" Width="130" Height="34" FontSize="13" FontWeight="SemiBold"
                            Foreground="White" Cursor="Hand" Click="btnSacuvaj_Click" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8,4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#55EFC4" Offset="0"/>
                                <GradientStop Color="#00B894" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button Content="Zatvori" Width="90" Height="34" FontSize="13" FontWeight="SemiBold"
                            Foreground="#636E72" Cursor="Hand" Click="btnZatvori_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="8,4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F0F2F5" Offset="0"/>
                                <GradientStop Color="#DFE6E9" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
